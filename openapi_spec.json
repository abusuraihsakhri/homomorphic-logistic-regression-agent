{
  "openapi": "3.1.0",
  "info": {
    "title": "Homomorphic Logistic Regression Agent — Example Rules API",
    "description": "Deterministic, illustrative threshold checks; no encrypted computation, model training, or validated clinical risk prediction.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Service process available; not a clinical validation statement"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory application counters",
        "responses": {
          "200": {
            "description": "JSON operational counts"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured rules dossier with an HMAC audit reference; dossier itself is not cryptographically signed"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock chat adapter (no model inference)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Access in-memory audit ledger and verify stored MAC signatures (operator token required)",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "403": {
            "description": "Missing or invalid audit log token"
          },
          "503": {
            "description": "Audit log endpoint disabled (token not configured)"
          }
        },
        "parameters": [
          {
            "name": "X-Audit-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Operator token configured via AUDIT_LOG_READ_TOKEN"
          }
        ]
      }
    }
  }
}
